# ---- Python ----
.venv/
**/__pycache__/
*.pyc
*.pyo
*.pyd
.env

# pytest artifacts (stray cache dirs created on permission-restricted filesystems)
pytest-cache-files-*/
.pytest_cache/

# ---- Terraform ----
# State files contain resource IDs and may contain secret values
/terraform/terraform.tfstate
/terraform/terraform.tfstate.backup
/terraform/.terraform/
/terraform/.terraform.lock.hcl

# Generated Lambda deployment artifact
/terraform/lambda_function.zip

# Debug artifacts (downloaded copy of the deployed function for inspection)
/terraform/deployed.zip
/terraform/deployed_check/

# Saved plan files - these embed variable values (incl. secrets) in plaintext
/terraform/main-plan-*
*.tfplan

# Terraform run logs
/terraform/apply.log
/terraform/terraform_apply_output.txt

# Local variable overrides (may contain secrets)
*.tfvars
*.tfvars.json

# ---- Lambda package - pip-installed dependencies ----
# Terraform's null_resource pip-installs all runtime deps into
# lambda-package/ before zipping. Ignore the entire directory's
# contents, then re-include only the hand-written source modules
# and the requirements manifest. This auto-ignores any new/updated
# dependency (boto3, botocore, ldap3, etc.) without maintenance.
lambda-package/*
!lambda-package/*.py
!lambda-package/requirements.txt

# ---- Editors / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---- Project-specific scratch (local-only notes & artifacts) ----
Artifacts.md
DEBUG_COMMANDS.md
DEBUG_SESSION_SUMMARY.md
image.png
# Session summaries (local-only notes from cowork debugging sessions)
SESSION_SUMMARY_*.md
